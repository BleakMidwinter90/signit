    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.79.0",
    "playwright": "^1.62.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
